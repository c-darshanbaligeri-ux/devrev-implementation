{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/bootstrap-workspace.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/push-learnings.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "devrev-aai-plugins": {
      "source": {
        "source": "github",
        "repo": "devrev/aai-skills"
      }
    },
    "devrev-qk-agents": {
      "source": {
        "source": "github",
        "repo": "QK-SnapIn/devrev-qk-agents"
      }
    }
  },
  "enabledPlugins": {
    "dashboard-dev@devrev-aai-plugins": true,
    "dataset-builder@devrev-aai-plugins": true
  }
}
