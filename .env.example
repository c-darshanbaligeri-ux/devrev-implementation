# DevRev credentials — creating .env from this file is the ONLY manual setup step.
# DEVREV_PAT: DevRev → Settings → Account → Personal Access Tokens
# (DEVREV_PAT and DEVREV_API_KEY are synonyms; scripts needing DEVREV_TOKEN get it aliased — see CLAUDE.md.)
DEVREV_PAT=your_personal_access_token
DEVREV_ENDPOINT=https://api.devrev.ai

# Optional — only for AI-agent building against the internal API (skills/7-agent-building):
# ORG_PAT=your_org_pat

# Optional — path to the DevRev OpenAPI specs used to ground internal-API payloads.
# The bootstrap already clones them here; uncomment to make the location explicit:
# DEVREV_API_SPECS=repos/api-specs
