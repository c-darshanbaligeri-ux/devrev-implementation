#!/usr/bin/env python3
"""devrev-import-workflow: import a workflow template into a DevRev org via the API, validate it, optionally publish it.

    devrev-import-workflow templates/my-workflow.json [--publish] [--version-of workflow-N] [--dry-run]

Thin launcher for skills/6-workflows/scripts/import_workflow.py (run with --help for the flow, flags and exit codes).
It stops at a validated draft unless --publish is given. Finds the script relative to this file, so it works from a
repo checkout and from an installed plugin.
"""
import runpy
import sys
from pathlib import Path

SCRIPT = Path(__file__).resolve().parents[1] / "skills" / "6-workflows" / "scripts" / "import_workflow.py"

if __name__ == "__main__":
    if not SCRIPT.exists():
        sys.exit(f"devrev-import-workflow: {SCRIPT} is missing")
    sys.argv[0] = str(SCRIPT)
    runpy.run_path(str(SCRIPT), run_name="__main__")
