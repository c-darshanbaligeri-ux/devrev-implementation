#!/usr/bin/env python3
"""devrev-validate-workflow: check a workflow template file offline, before importing it.

    devrev-validate-workflow templates/my-workflow.json [--json] [--strict]

Thin launcher for skills/6-workflows/scripts/validate_template.py (run with --help there for the rule list). It finds
the script relative to this file, so it works from a repo checkout and from an installed plugin.
"""
import runpy
import sys
from pathlib import Path

SCRIPT = Path(__file__).resolve().parents[1] / "skills" / "6-workflows" / "scripts" / "validate_template.py"

if __name__ == "__main__":
    if not SCRIPT.exists():
        sys.exit(f"devrev-validate-workflow: {SCRIPT} is missing")
    sys.argv[0] = str(SCRIPT)
    runpy.run_path(str(SCRIPT), run_name="__main__")
